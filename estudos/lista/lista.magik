_local lista << rope.new()
lista.add("item 1")
lista.add("item 2")
lista.add("item 3")
write("Lista de itens: " + lista.write_string) #mostrar a lista completa
lista.remove(1) #remover o item 2
lista.last() #mostrar o ultimo item da lista
lista.first() #mostrar o primeiro item da lista
lista.size() #mostrar o tamanho da lista
lista[2] << "troca" #trocar o item 3 por "troca"
_for item _over lista.fast_elements()
_loop
	write("Item: " + item)
    _endloop
    