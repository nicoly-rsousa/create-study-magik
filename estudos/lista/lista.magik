_local lista << rope.new()
lista.add("item 1")
lista.add("item 2")
lista.add("item 3")
write("Lista de itens: " + lista.write_string) #mostrar a lista completa
lista.remove(1) #remover o item 2
write("Último item: " + lista.last()) #mostrar o ultimo item da lista
write("Primeiro item: " + lista.first()) #mostrar o primeiro item da lista
write("Tamanho da lista: " + lista.size().write_string) #mostrar o tamanho da lista
lista[2] << "troca" #trocar o item 3 por "troca"
_for item _over lista.fast_elements()
_loop
	write("Item: " + item)
_endloop
